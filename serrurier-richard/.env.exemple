# ===========================================================================
#  Copiez ce fichier en « .env » puis renseignez vos valeurs.
#
#      cp .env.exemple .env
#
#  .env est ignoré par Git : aucun identifiant ne partira sur GitHub.
#  Ce fichier-ci ne doit contenir que des exemples, jamais de vraie valeur.
# ===========================================================================

# --- FTP Hostinger ----------------------------------------------------------
# hPanel > Fichiers > Comptes FTP. Le mot de passe est celui du compte FTP,
# pas celui de votre compte Hostinger.
FTP_HOST=ftp.exemple.fr
FTP_USER=u000000000
FTP_PASS=mot-de-passe-ftp
FTP_DIR=/public_html

# --- Déploiement -----------------------------------------------------------
# Nombre d'envois simultanés (1 à 8). Au-delà, Hostinger peut refuser.
FTP_PARALLELE=4
